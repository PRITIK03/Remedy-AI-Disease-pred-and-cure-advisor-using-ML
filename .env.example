# Remedy-AI configuration
# Copy to .env and adjust. Never commit real secrets.

# --- Application -----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# --- Legacy Flask dev server (Phase 0/1 compatibility) ----------------------
MODEL_DIR=./
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# --- Model serving ----------------------------------------------------------
# v2 = modern calibrated pipeline (default); v1 = legacy (regression only)
MODEL_VERSION=v2

# --- API server -------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# --- Databases (placeholders; use real secrets via .env, never commit) ------
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/remedy_ai
REDIS_URL=redis://localhost:6379/0

# Postgres container settings (docker-compose). POSTGRES_PASSWORD must match
# the password embedded in DATABASE_URL above. Used only by Compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=remedy_ai
POSTGRES_PORT=5432

# Security header lifetime (compose default: 31536000 = 1 year).
HSTS_MAX_AGE_SECONDS=31536000

# Test database credentials (used by backend/tests/conftest.py; CI supplies
# its own values — do not hardcode real passwords in source files)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=postgres
TEST_DB_PASSWORD=

# --- CORS --------------------------------------------------------------------
# Comma-separated explicit origins. Wildcard refused when APP_ENV=production.
CORS_ORIGINS=http://localhost:3000

# --- Authentication / sessions (Phase 6) -------------------------------------
# Session lifetime in seconds (default 8h). Applies to the Redis session TTL
# AND the session cookie Max-Age.
SESSION_TTL_SECONDS=28800
# Cookie name (a __Host- prefix is added automatically when enabled below).
SESSION_COOKIE_NAME=remedy_session
# Set ONLY behind HTTPS in production. Never true on plain-HTTP localhost
# (the cookie would not be sent).
COOKIE_SECURE=false
# Leave empty for a host-only cookie. Required empty for __Host- cookies.
COOKIE_DOMAIN=
# Enable ONLY when deployed on HTTPS with a single dedicated domain:
# adds the __Host- prefix (Secure + Path=/ + no Domain enforced).
USE_HOST_PREFIXED_COOKIE=false
# HMAC secret for CSRF tokens. REQUIRED in production (the app refuses to
# start without it there). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Auth rate limiting (Redis fixed window, per client IP) ------------------
AUTH_RATE_LIMIT_REGISTER_PER_HOUR=10
AUTH_RATE_LIMIT_LOGIN_PER_HOUR=20

# --- Legacy risk threshold (Flask v1/v2 HTML path) ---------------------------
RISK_THRESHOLD=0.5

# --- RAG / knowledge base (Phase 4) -----------------------------------------
# OpenAI-compatible embeddings endpoint (OpenRouter shown; Ollama, OpenAI, etc.
# also work). Changing EMBEDDING_MODEL or EMBEDDING_DIMENSION requires
# re-running the ingestion script.
EMBEDDING_API_BASE=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=60
# Retrieval settings
RAG_RETRIEVAL_TOP_K=6
RAG_MIN_SIMILARITY=0.25

# --- LLM (Phase 4 guidance) --------------------------------------------------
# OpenAI-compatible chat completions endpoint. Guidance is generated ONLY when
# the user explicitly requests it — never automatically per page render.
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# Low temperature for health information.
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_PROMPT_VERSION=v1

# --- Medical Report Storage (Phase 7) ----------------------------------------
STORAGE_BACKEND=local
REPORTS_STORAGE_DIR=data/reports
REPORTS_MAX_BYTES=10485760
REPORTS_MAX_PDF_PAGES=10
# Optional dedicated multimodal vision model if different from LLM_MODEL
MULTIMODAL_MODEL=

# --- MCP server (Phase 8) ---------------------------------------------------
# The MCP server is READ-ONLY and must be bound to exactly ONE Remedy-AI
# account. Without this variable the server refuses to start, so it can never
# run unscoped. Copy the UUID from GET /api/v1/auth/me after signing in.
MCP_USER_ID=

# --- S3-compatible object storage (Phase 9) ---------------------------------
# STORAGE_BACKEND is defined once above (Phase 7 section): `local` (default,
# dev) or `s3`. Any real or multi-instance deployment must use `s3`.
# Leave S3_ENDPOINT_URL empty for real AWS S3. Set it for MinIO/R2/B2.
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
# LEAVE BOTH EMPTY IN PRODUCTION to use the pod's IAM role / workload identity.
# That is strongly preferred over static keys. Only set these for MinIO locally
# or for a provider that has no IAM role support.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# `path` for MinIO and most self-hosted gateways; `virtual` for AWS S3.
S3_ADDRESSING_STYLE=path
# Recommended for real medical documents: AES256, or aws:kms + S3_KMS_KEY_ID.
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=
# Lifetime of the presigned read URLs used instead of public object links.
S3_PRESIGNED_EXPIRY_SECONDS=900

# --- OpenTelemetry (Phase 9) -------------------------------------------------
# Disabled by default: with no endpoint, spans are created but dropped, so
# telemetry costs nothing. Only operational attributes are ever recorded
# (method, route, status, latency, error type) — never bodies, medical data,
# tokens, cookies, or query strings. See backend/app/telemetry.py.
OTEL_ENABLED=false
# OTLP/HTTP base URL, e.g. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

